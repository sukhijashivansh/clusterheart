{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "https://clusterheart-server.clusterheart.com/login" },
    { "source": "/signup", "destination": "https://clusterheart-server.clusterheart.com/signup" },
    { "source": "/account", "destination": "https://clusterheart-server.clusterheart.com/account" },
    { "source": "/admin", "destination": "https://clusterheart-server.clusterheart.com/admin" },
    { "source": "/admin/broadcast", "destination": "https://clusterheart-server.clusterheart.com/admin/broadcast" },
    { "source": "/forgot", "destination": "https://clusterheart-server.clusterheart.com/forgot" },
    { "source": "/reset", "destination": "https://clusterheart-server.clusterheart.com/reset" },
    { "source": "/app", "destination": "https://clusterheart-server.clusterheart.com/app" },
    { "source": "/api/:path*", "destination": "https://clusterheart-server.clusterheart.com/api/:path*" }
  ],
  "headers": [
    {
      "source": "/clusterheart.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ]
}
