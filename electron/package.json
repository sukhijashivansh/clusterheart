{
  "name": "clusterheart",
  "productName": "Clusterheart",
  "version": "1.0.5",
  "description": "Kubernetes / EKS health + FinOps dashboard",
  "homepage": "https://github.com/Decodx09/clusterheart",
  "author": "Shivansh Sukhija <sukhija.shivansh@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.clusterheart.app",
    "productName": "Clusterheart",
    "protocols": [
      {
        "name": "Clusterheart",
        "schemes": [
          "clusterheart"
        ]
      }
    ],
    "afterSign": "scripts/afterSign.js",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "login.html",
      "login.js",
      "!resources/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": null,
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/clusterheart-darwin-arm64",
          "to": "clusterheart-darwin-arm64"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/clusterheart-windows-amd64.exe",
          "to": "clusterheart-windows-amd64.exe"
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "Shivansh Sukhija <sukhija.shivansh@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/clusterheart-linux-amd64",
          "to": "clusterheart-linux-amd64"
        },
        {
          "from": "resources/clusterheart-linux-arm64",
          "to": "clusterheart-linux-arm64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
