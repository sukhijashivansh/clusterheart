# Copy to .env and fill in. The server loads .env at startup. Keep .env private.

# --- required -------------------------------------------------------------
# MongoDB Atlas connection (mongodb+srv://... from the Atlas UI).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name: users, teams, AI chats and settings live here.
MONGO_DB=clusterheart
# Comma-separated emails allowed to reach /admin and approve users.
ADMIN_EMAILS=you@yourco.com
# Listen address (0.0.0.0:9000 behind Caddy on the server).
ADDR=127.0.0.1:9000

# The SRE control plane that holds clusters, servers, metrics and incidents.
SRE_CONTROLPLANE_URL=http://127.0.0.1:9100
SRE_ADMIN_TOKEN=change-me

# --- email (password reset + team invites) ---------------------------------
# Gmail with an app password. Without these, emails are logged, not sent.
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=you@yourco.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Base for links in emails.
PUBLIC_BASE_URL=https://www.clusterheart.com

# --- optional ---------------------------------------------------------------
# AI assistant (OpenRouter). OPENROUTER_MODEL pins one model; otherwise free
# models are tried in turn.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# Skip the admin approval gate for every new account.
# AUTO_APPROVE=false
# Fix the session-signing key (otherwise generated into SECRET_FILE).
# SESSION_SECRET=some-long-random-string
# SECRET_FILE=secret.key
# What the install snippets point agents at (defaults are production).
# AGENT_CONTROLPLANE_URL=https://clusterheart-server.clusterheart.com/cp
# AGENT_MANIFEST_URL=https://clusterheart.com/agent.yaml
# REMEDIATION_MANIFEST_URL=
# HOST_INSTALL_URL=
